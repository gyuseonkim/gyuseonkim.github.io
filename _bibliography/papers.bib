  url          = {https://ieeexplore.ieee.org/document/10937047/},
  abstract     = {The paper develops a two-stage method for delivering high-quality digital-twin services through cloud-assisted multitier networks. First, quantum multi-agent reinforcement learning schedules individually quality-controlled segments of cloud-hosted virtual objects while incorporating age of information for low-latency service. Because each edge can select more segments as the service grows, its action space expands exponentially and becomes difficult for conventional MARL to learn; the quantum-inspired scheduler reduces that decision dimension to logarithmic scale. The second stage provides fast and seamless delivery of the differentiated segments requested by each user through one of the nearby edge nodes. A neural-Myerson second-price auction provides truthful, distributed allocation while realizing low-complexity computation by avoiding NP-hard integer programming. Compared with the evaluated benchmarks, the method reports a high-dimensional reward 8.33 times as large and revenue 1.18 times as large.},
  abbr         = {IEEE IoT-J},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

