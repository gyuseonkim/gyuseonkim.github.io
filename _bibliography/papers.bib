@inproceedings{DC25_QRL_Lightweight_Control,
  author       = {Kim, Gyu Seon and Kim, Joongheon},
  title        = {경량화 제어 모델을 위한 양자 강화학습 (Lightweight Control Modeling via Quantum Reinforcement Learning)},
  booktitle    = {Proc. 2025년 대한전자공학회 추계학술대회 (Institute of Electronics and Information Engineers Autumn Annual Conference 2025)},
  year         = {2025},
  month        = {November},
  pages        = {1584--1587},
  location     = {Gwangju, Republic of Korea},
  additional_info = {, pp. 1584-1587},
  note         = {양자인공지능 기술 특별세션},
  url          = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12551331},
  html         = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12551331},
  award        = {2025년도 대한전자공학회 추계학술대회 우수논문상 (Best Paper Award)},
  award_name   = {우수논문상 (Best Paper Award)},
  abstract     = {Demand for lightweight and efficient controllers exposes a limitation of conventional deep reinforcement learning in resource-constrained systems. Although classical RL can adapt well to nonlinear and uncertain dynamics, its large neural networks impose computation and memory costs that hinder real-time control. The paper addresses this problem with a quantum-reinforcement-learning framework implemented on the OpenAI Gym CartPole environment. Its quantum neural network uses superposition and entanglement to encode state–action information compactly, reducing the number of trainable parameters while retaining robust control behavior. Against classical RL controllers, the quantum controller attains comparable stability with only a fraction of their parameter count and therefore demonstrates that a lightweight control model is feasible. The results identify QRL as a promising basis for next-generation adaptive controllers that combine intelligent behavior with very low computational overhead.},
  abbr         = {IEIE},
  category     = {domestic_conference},
  bibtex_show  = {true},
  selected     = {false}
}

