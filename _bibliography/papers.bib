  html         = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE11554742},
  abstract     = {본 논문은 해양 환경에서의 폭발성 발사체 무기인 자율 어뢰의 목표 지점 도달을 위한 기동 최적화 방법을 제안한다. 이때 실제 해양 환경에서의 지형물로 인한 장애물과 어뢰의 각도 전환 시 발생하는 변침점 최소화를 함께 고려하여 어뢰 기동의 자율성과 효율성을 증대하고자 한다. 본 연구에서는 최대 회전각도가 90도의 어뢰의 행동(Action)을 반영한 2차원 그리드 월드에서의 환경(Environment)을 정의한다. 이후 Markov Decision Process 기반 강화학습 알고리즘인 Q-Learning을 사용하여 어뢰 기동 경로 계획을 수립한다. 최종적으로 본 알고리즘은 무작위 알고리즘과 비교하여 변침점 생성을 약 91% 절약하는 최적의 어뢰 기동을 도출할 수 있다.},
  abbr         = {KICS AI},
  category     = {domestic_conference},
  bibtex_show  = {true},
  selected     = {false}
}

@inproceedings{DC23_RL_Fighter_Scheduling,
  author       = {Kim, Gyu Seon and Park, Soohyun and Kim, Joongheon},
  title        = {효율적인 군사 작전을 위한 강화학습 기반 전투기 공항 스케쥴링 및 최적화: 오산 공군기지 적용 사례 (Utilizing Reinforcement Learning for Enhanced Efficiency in Fighter Airport Scheduling: A Case Study of Osan Air Base)},
