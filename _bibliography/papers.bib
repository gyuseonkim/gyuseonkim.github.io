  doi          = {10.7840/kics.2024.49.3.333},
  url          = {https://www.kci.go.kr/kciportal/ci/sereArticleSearch/ciSereArtiView.kci?sereArticleSearchBean.artiId=ART003061223},
  award        = {한국통신학회 국내논문지 우수논문상 (Best Paper Award)},
  award_name   = {한국통신학회 국내논문지 우수논문상 (Best Paper Award)},
  abstract     = {Research on future submarine systems is increasingly focused on integrated automation for intelligent mission support so that combat performance can be improved with advanced technology. One important component is the modernization of torpedo-countermeasure tactics as the capabilities of enemy torpedoes and decoys evolve. Because a torpedo usually travels far faster than a submarine, the threatened vessel must calculate an accurate response under severe time pressure. The paper formulates that decision as a reinforcement-learning problem and develops an algorithm that can derive an enemy-torpedo countermeasure for different situations while choosing the submarine’s evasive course. The learning process accounts for variables that can arise in the maritime environment, enabling the policy to adapt instead of following a fixed maneuver. The authors evaluate the algorithm’s effectiveness and use the results to establish its potential applicability to countermeasure tactics in real marine conditions.},
  abbr         = {JKICS},
  category     = {domestic_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{RL_LEO_Routing_KR,
  author       = {Kim, Gyu Seon and Park, Soohyun and Kim, Joongheon and Kim, Yeonggoo and Ha, Jaekyoung and Jun, Byung-Hyun},
  title        = {신뢰성 있는 지구 저궤도 위성 통신망 최적화를 위한 강화학습 기반 동적 라우팅 알고리즘 (Reinforcement Learning-Based Dynamic Routing for Robust Optimization of Low Earth Orbit ({LEO}) Satellite Communication Networks)},
  journal      = {한국통신학회논문지 (The Journal of Korean Institute of Communications and Information Sciences)},
  year         = {2023},
  month        = {September},
  volume       = {48},
  number       = {9},
  pages        = {1123--1134},
  doi          = {10.7840/kics.2023.48.9.1123},
  url          = {https://www.kci.go.kr/kciportal/ci/sereArticleSearch/ciSereArtiView.kci?sereArticleSearchBean.artiId=ART002997121},
  abstract     = {The emergence of 6G has intensified interest in satellite systems that could deliver Internet access around the globe. Low-Earth-orbit satellites are particularly attractive for communications because they operate much closer to Earth than many other satellite platforms. Their high orbital velocity and the large number of spacecraft sharing an orbit, however, continually reshape network connectivity and make effective inter-satellite routing necessary. This study applies reinforcement learning to design a routing algorithm that optimizes communications across a dynamic LEO constellation. Several learning algorithms are evaluated on satellite topologies representative of conditions that may occur in space. The comparison is used both to assess the proposed approach’s performance and to show that reinforcement-learning-based routing can be deployed between satellites in an actual space environment.},
  abbr         = {JKICS},
  category     = {domestic_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{MARL_UAM_Surveillance_KR,
  author       = {Park, Chanyoung and Kim, Gyu Seon and Lee, Kyeongjin and Yun, Ilsoo},
  title        = {자율적인 {UAM} 시스템의 효율적인 무인 정보수집 및 감시를 위한 멀티 에이전트 기반 심층 강화학습 (Multi-Agent Deep Reinforcement Learning for Efficient Unattended Information Gathering and Monitoring of Autonomous {UAM} Systems)},
  journal      = {한국통신학회논문지 (The Journal of Korean Institute of Communications and Information Sciences)},
  year         = {2023},
  month        = {February},
  volume       = {48},
  number       = {2},
  pages        = {176--184},
  doi          = {10.7840/kics.2023.48.2.176},
  url          = {https://www.kci.go.kr/kciportal/ci/sereArticleSearch/ciSereArtiView.kci?sereArticleSearchBean.artiId=ART002930352},
  abstract     = {Multi-agent deep reinforcement learning allows a group of agents to communicate and cooperate toward one shared objective. The study uses this capability to replace part of the urban surveillance and information-collection role of fixed CCTV cameras with multiple Urban Air Mobility vehicles. Whereas a stationary camera offers only a limited view from one location, an autonomous UAM platform can move with a surveillance target and deliver flexible, dependable visual information in real time. The proposed system employs CommNet for communication among agents, enabling the UAM vehicles to coordinate their monitoring and gather information efficiently. In this way, the framework turns several mobile aerial vehicles into a cooperative, unattended urban observation system.},
  abbr         = {JKICS},
  category     = {domestic_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@inproceedings{DC26_LLM_AntiDrone,
  author       = {Kim, Gyu Seon and Kim, Joongheon},
  title        = {강건한 안티드론 방공 시스템을 위한 {LLM}-유도 강화학습 기반 무인기 자율 제어 ({LLM}-based Reinforcement Learning for {UAV} Control in Defense Systems)},
  booktitle    = {Proc. 2026년 한국통신학회 동계종합학술발표회 (Korean Institute of Communications and Information Sciences Winter Conference 2026)},
  year         = {2026},
