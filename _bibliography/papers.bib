  annotation   = {Gyu Seon Kim is a co-first author.},
  abstract     = {Deep neural models have increasingly replaced classical proactive-caching algorithms, and enlarging those models can improve capability at the cost of greater storage and computation. Their fixed structures are difficult to deploy in realistic settings where user mobility continually changes the active population and therefore the dimensions of model inputs. Conventional implementations may have to expand the input layer to the largest anticipated size or fill absent values through imputation. SlimFRL integrates slimmable neural networks with federated reinforcement learning so that network width can be adjusted during training according to the current number of users. The slimmable structure also selects a suitable input dimension without imputation, avoiding unnecessary inputs and improving performance in dynamic environments in practice. The paper proposes several SlimFRL training algorithms, supports them with convergence analysis, and validates their advantages in reward and additional cost functions through various experiments.},
  abbr         = {IEEE TON},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QMARL_CubeSat_HALE,
