@inproceedings{WiOpt24_MARL_Aircraft_Taxiing,
  author       = {Lee, Sungjoon and Kim, Gyu Seon and Park, Soohyun and Kim, Joongheon},
  title        = {Advanced Taxiing Path Guidance Using Multi-Agent Reinforcement Learning for Air Traffic Management},
