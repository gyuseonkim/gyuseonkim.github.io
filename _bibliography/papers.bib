  year         = {2025},
  month        = {October},
  volume       = {2724},
  series       = {Communications in Computer and Information Science},
  pages        = {51--56},
  address      = {West Lafayette, IN, USA},
  publisher    = {Springer Nature Singapore},
  doi          = {10.1007/978-981-95-7829-0_6},
  url          = {https://link.springer.com/chapter/10.1007/978-981-95-7829-0_6},
  abstract     = {Reinforcement learning (RL) utilizing classical neural networks (NNs) has achieved substantial progress across numerous application domains. Nevertheless, classical RL faces significant challenges in training when applied to systems with high-dimensional action spaces, such as coordinated satellite networks. In these scenarios, the exponential increase in model parameters imposes heavy computational requirements, thereby constraining scalability and slowing convergence. Quantum reinforcement learning (QRL), which incorporates quantum neural networks (QNNs), provides a promising alternative by exploiting quantum mechanical properties, including superposition and entanglement. Through QNNs, multiple states can be compactly represented using a limited number of quantum bits (qubits), effectively reducing computational overhead. Due to these characteristics—namely, rapid convergence and enhanced scalability—QRL constitutes a suitable substitute for classical RL in coordinated satellite applications. Moreover, the proposed QRL framework mitigates the curse of dimensionality by efficiently leveraging qubit-based representations. In experimental environments characterized by high-dimensional action spaces, the proposed algorithm demonstrates superior training performance compared to conventional RL approaches.},
  abbr         = {PQAI},
  category     = {international_conference},
  bibtex_show  = {true},
  selected     = {false}
}

@inproceedings{ICTC25_LEO_6G_Roadmap,
  author       = {Kim, Gyu Seon and Cho, In-Sop and Kim, Joongheon},
  title        = {Strategic Role of {LEO} Satellites in the {6G} Roadmap and Orbital Analysis},
  booktitle    = {Proc. IEEE International Conference on Information and Communication Technology Convergence (ICTC)},
  year         = {2025},
  month        = {October},
  pages        = {1996--2001},
  address      = {Jeju, Republic of Korea},
  doi          = {10.1109/ICTC66702.2025.11388186},
  url          = {https://ieeexplore.ieee.org/document/11388186/},
  abstract     = {Despite substantial advances in terrestrial and wireless networking, delivering uniform, high-quality global Inter-net access remains a persistent challenge. Infrastructure limitations, coupled with vulnerabilities to natural disasters and armed conflicts, frequently lead to prolonged service outages in affected regions. Satellite communications increasingly serve as a critical complement to ground networks, offering resilience and rapid deployability in crisis conditions. Historically, non-terrestrial networks (NTNs) have relied on geostationary Earth orbit (GEO) satellites, which provide broad coverage but incur high latency due to their high altitude. Low Earth orbit (LEO) constellations, operating at approximately 500–2,000 km, alleviate these limitations by shortening propagation paths and enabling flexible, wide-area coverage through large-scale deployments. This article offers a comprehensive survey of the strategic role of LEO satellites within the evolving 6G NTN systems. The discussion characterizes key satellite communication frequency bands and their use cases, analyzes the incorporation of LEO systems into the 6G roadmap, and highlights advantages in latency reduction, coverage scalability, and deployment agility. Additionally, orbital modeling methodologies based on two-line element (TLE) data are presented for satellite position prediction and ground track visualization, with a particular focus on prominent constellations, such as Starlink. This paper underscores the potential of LEO architectures as a foundational means to deliver resilient, economical, and globally accessible Internet services in the 6G era.},
  abbr         = {IEEE ICTC},
  category     = {international_conference},
  bibtex_show  = {true},
  selected     = {false}
}

@inproceedings{WiOpt25_QRL_Aircraft_Control,
  author       = {Kim, Gyu Seon and Chung, Jaehyun and Duong, Trung Q. and Park, Soohyun and Kim, Joongheon},
