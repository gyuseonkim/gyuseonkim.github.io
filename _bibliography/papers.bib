  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QMARL_TN_NTN,
  author       = {Park, Soohyun and Kim, Gyu Seon and Han, Zhu and Kim, Joongheon},
  title        = {Quantum Multi-Agent Reinforcement Learning is All You Need: Coordinated Global Access in Integrated {TN/NTN} Cube-Satellite Networks},
