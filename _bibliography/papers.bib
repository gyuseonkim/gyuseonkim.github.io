@article{QRL_Network_Scheduling,
  author       = {Kim, Gyu Seon and Roh, Emily Jimin and Park, Soohyun and Kim, Joongheon},
  title        = {Exponentially Scalable Quantum Reinforcement Learning for Large-Scale Network Scheduling},
  journal      = {IEEE Internet of Things Journal},
  year         = {2026},
  note         = {Early Access},
  doi          = {10.1109/JIOT.2026.3717839},
  url          = {https://ieeexplore.ieee.org/document/11627874/},
  abstract     = {Parameterized-quantum-circuit learning has attracted growing interest, and quantum reinforcement learning (QRL) is especially promising for faster computation. Its reliance on quantum measurements for producing outputs nevertheless creates a severe scalability problem when an application has a very large output space. Conventional QRL designs can also require a rapidly growing qubit register to produce high-dimensional outputs, which is especially burdensome for noisy intermediate-scale quantum hardware. The paper introduces exponentially scalable QRL (ES-QRL), which uses basis measurement to support large-scale network scheduling with extremely high-dimensional outputs. This measurement design overcomes the restriction imposed by a small qubit count, allowing the model to train over an exponentially large output space while using only a few qubits. Evaluations on network-scheduling tasks with numerous output dimensions show that ES-QRL performs better than the compared classical RL and existing QRL frameworks.},
  abbr         = {IEEE IoT-J},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{MARL_Aerial_Networks,
  author       = {Kim, Gyu Seon and Roh, Emily Jimin and Jung, Soyi and Park, Soohyun and Kim, Joongheon},
  title        = {Scale-Reconfigurable Multi-Agent Reinforcement Learning for Aerial Networks in Dynamic Environments},
  journal      = {IEEE Transactions on Mobile Computing},
  year         = {2026},
  note         = {Early Access},
  doi          = {10.1109/TMC.2026.3709180},
  url          = {https://ieeexplore.ieee.org/document/11592603/},
  abstract     = {Large constellations of CubeSats and deployments of many UAVs are needed to build realistic aerial access networks with global coverage. In such a system, each ground station must continually determine which non-terrestrial devices to select and from which devices it will receive network service. The number and type of reachable devices change over time, producing uncertain dynamic topologies that conflict with conventional reinforcement-learning models whose supported device count is fixed during both training and inference. To solve this practical mismatch, the paper proposes scale-reconfigurable multi-agent reinforcement learning (SR-MARL). Its flexible neural networks alter their architecture according to the current mix and population of CubeSats and UAVs within each ground station's communication range, enabling adaptive station management and control. In the reported evaluation, SR-MARL achieves 1.64 times the average network performance and 2.39 times the average residual device energy of the benchmark methods.},
  abbr         = {IEEE TMC},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{RL_LEO_Fault_Routing,
  author       = {Kim, Gyu Seon and Im, Chaemoon and Kim, Yeong Goo and Ha, Jaekyoung and Kim, Joongheon},
  title        = {Learning-based Resilient Dynamic Routing for Fault-Tolerant Robust {LEO} Satellite Networks},
  journal      = {IEEE Internet of Things Journal},
  year         = {2026},
  note         = {Early Access},
  doi          = {10.1109/JIOT.2026.3701260},
  url          = {https://ieeexplore.ieee.org/document/11554368/},
  abstract     = {Geographic and economic barriers, together with disruptions caused by disasters and warfare, make seamless and resilient global Internet access difficult. Satellite communication can bridge those gaps, although the altitude of conventional GEO systems produces inherent latency. LEO satellites reduce propagation delay and can improve network performance, but their high orbital speed continually changes both topology and inter-satellite-link availability. Conventional routing reacts poorly to those changes and to congestion, leading to inefficient path choices and greater delay. The proposed adaptive reinforcement-learning non-terrestrial-network routing algorithm, ARL-NTNR, continually interacts with the evolving constellation to learn and update its routing policy in real time. By balancing shortest-path decisions against current queue backlogs, it responds to congestion and is reported to reduce packet delay and packet loss.},
  abbr         = {IEEE IoT-J},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QRL_Aircraft_Control,
  author       = {Kim, Gyu Seon and Chung, Jaehyun and Park, Soohyun and Jung, Soyi and Duong, Trung Q. and Kim, Joongheon},
  title        = {Quantum Learning for Autonomous Aircraft Control: A Reinforcement Learning Perspective},
  journal      = {IEEE Communications Magazine},
  year         = {2026},
  note         = {Early Access},
  doi          = {10.1109/MCOM.001.2500656},
  url          = {https://ieeexplore.ieee.org/document/11523714/},
  abstract     = {Aircraft attitude control must maintain stability under disturbances such as turbulence and vortices. Although reinforcement-learning controllers can adapt to uncertain dynamics, the number of trainable parameters and the resulting computation can prevent their practical deployment on airborne systems. This work replaces the classical neural network in an actor-critic attitude controller with a quantum neural network, using superposition and entanglement to create a computationally efficient and lightweight QRL controller. The method is tested in a simulated flight-control environment based on the aerodynamic characteristics of a Boeing B777-300X and exposed to stochastic vortical disturbances. The quantum controller reduces the number of training parameters by approximately a factor of 760 relative to its classical-neural-network counterpart while retaining resilient attitude-control behavior, supporting QRL as a parameter-efficient option for aircraft with limited computing resources.},
  abbr         = {IEEE ComMag},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QNN_Mobility_Networks,
  author       = {Lee, Hyunsoo and Kim, Gyu Seon and Roh, Emily Jimin and Jung, Soyi and Park, Soohyun and Duong, Trung Q. and Kim, Joongheon},
  title        = {Quantum Jump to Connected Worlds: Paradigm Shifts in Mobility and Network Applications via Quantum Neural Networks},
  journal      = {IEEE Network},
  year         = {2026},
  note         = {Early Access},
  doi          = {10.1109/MNET.2026.3671113},
  url          = {https://ieeexplore.ieee.org/document/11436035/},
  abstract     = {Quantum computing and artificial intelligence are increasingly being combined in both academic and industrial research, creating a quantum-AI field with potential benefits for mobility and communication networks. This article introduces quantum neural networks and examines how they can be used in distributed networking applications. It first surveys industrial activity in quantum AI and then explains the underlying concepts of quantum computation and quantum neural-network design. The discussion covers three principal learning families for mobility and networking: quantum reinforcement learning, quantum convolutional neural networks, and quantum distributed learning. The article concludes by considering how these technologies may reshape future connected-mobility and network systems.},
  abbr         = {IEEE Network},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{RL_Military_Drones,
  author       = {Kim, Gyu Seon and Lee, Sungjoon and Woo, Taejin and Park, Soohyun},
  title        = {Cooperative Reinforcement Learning for Military Drones over Large-Scale Battlefields},
  journal      = {IEEE Transactions on Intelligent Vehicles},
  year         = {2024},
  note         = {Early Access},
  doi          = {10.1109/TIV.2024.3472213},
  url          = {https://ieeexplore.ieee.org/document/10713174/},
  abstract     = {The shift toward autonomous military systems has made cooperative drone operations a central element of modern warfare. Their effectiveness depends on whether an entire swarm can act robustly in a complex, large battlefield while the target position changes dynamically. The control problem therefore combines three objectives: preserving cooperative swarm flight, maximizing coverage of the target bombing zone, and optimizing energy efficiency. The paper applies multi-agent deep reinforcement learning so the drones can coordinate these competing objectives rather than operate independently. To make the assessment representative of a known military platform, the simulations adopt characteristics of the Shahed-136 and use a battlefield volume of 40,000 cubic kilometers. The proposed approach is evaluated in terms of swarm-flight behavior, bombing success rate, and drone energy efficiency under dynamic target conditions.},
  abbr         = {IEEE T-IV},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QRL_Energy_CubeSat,
  author       = {Park, Soohyun and Kim, Gyu Seon and Jung, Soyi and Han, Zhu and Kim, Joongheon},
  title        = {Joint Sustainable Control and Quantum Reinforcement Learning for Energy-Efficient Cube-Satellite Networks},
  journal      = {IEEE Transactions on Mobile Computing},
  year         = {2026},
  month        = {July},
  volume       = {25},
  number       = {7},
  pages        = {10385--10401},
  additional_info = {, vol. 25, no. 7, pp. 10385-10401},
  doi          = {10.1109/TMC.2026.3664182},
  url          = {https://ieeexplore.ieee.org/document/11394814/},
  abstract     = {CubeSats are attractive for global networking and surveillance because several can be positioned together near Earth in a target orbit, but their small batteries limit mission duration. The paper treats orbital control and constellation scheduling as coupled energy-management problems and proposes a two-stage reinforcement-learning framework for operation under uncertainty. In the first stage, deep deterministic policy gradient controls the vertical orbital position of one CubeSat over a continuous action space. The second stage uses quantum multi-agent reinforcement learning with a projection-valued measure (PVM) to coordinate multiple CubeSats while reducing the scheduling-action dimension to logarithmic scale. The authors emphasize that the single-satellite maneuver and multi-satellite scheduling problems cannot be optimized separately when pursuing extreme energy efficiency. Compared with the evaluated baselines, the framework reports 1.51 times higher orbital-control performance, 2.71 times greater converged reward in very large action spaces, and 2.27 times higher average network performance.},
  abbr         = {IEEE TMC},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QRL_Reusable_Rocket,
  author       = {Kim, Gyu Seon and Chung, Jaehyun and Jung, Soyi and Park, Soohyun and Kim, Joongheon},
  title        = {Quantum Reinforcement Learning for Joint Control, Communication, and Computing in Stabilized Reusable Space Rocket},
  journal      = {IEEE Transactions on Aerospace and Electronic Systems},
  year         = {2026},
  month        = {March},
  volume       = {62},
  pages        = {3838--3863},
  additional_info = {, vol. 62, pp. 3838-3863},
  doi          = {10.1109/TAES.2025.3648981},
  url          = {https://ieeexplore.ieee.org/document/11316405/},
  abstract     = {Reusable rockets can lower launch costs and improve space-industry efficiency across repeated missions, but reliable operation throughout the complete mission requires control, communication, and onboard computing to be designed together. The proposed QRL-C3 framework addresses the poor training behavior that conventional reinforcement learning can exhibit in high-dimensional state and action spaces as their dimensions rise. It uses quantum neural networks with superposition and entanglement to improve information representation and processing within the quantum domain. Its control component supports robust reentry and precise landing, while a quantum multi-agent scheduler coordinates seamless communication with several ground stations for Internet-of-Things service. A third component manages image processing and transmission power through queue-aware, energy-efficient computing. These components operate jointly to improve mission performance and reusability. Validation with a SpaceX Falcon 9 model shows higher training efficiency than conventional RL approaches, and the work presents the framework as the first QAI-based integration of all three rocket subsystems for future space missions.},
  abbr         = {IEEE TAES},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{UAV_Integrated_CCC,
  author       = {Kim, Gyu Seon and Park, Soohyun and Jung, Soyi and Mohaisen, David and Kim, Joongheon},
  title        = {Integrated Control, Communication, and Computing for Mission-Critical Embedded Unmanned Aerial Vehicles},
  journal      = {IEEE Transactions on Aerospace and Electronic Systems},
  year         = {2026},
  month        = {February},
  volume       = {62},
  pages        = {682--703},
  additional_info = {, vol. 62, pp. 682-703},
  doi          = {10.1109/TAES.2025.3622092},
  url          = {https://ieeexplore.ieee.org/document/11204372/},
  abstract     = {Military UAVs are valued for their agility and ability to penetrate hostile territory, but they remain vulnerable to spoofed GPS signals that deliberately mislead navigation. To support flight when reliable GPS is unavailable, the paper develops a location-estimation method and analyzes UAV aerodynamics for rapid maneuvering and collision prevention. Reconnaissance by a UAV swarm also requires an uninterrupted and reliable communication system that remains robust as the formation moves under mission constraints. The proposed hybrid medium-access-control protocol therefore changes between carrier-sense multiple access and time-division multiple access according to the vehicles' movement states during swarm flight. Since optimizing communication alone can neglect energy consumption and onboard queue stability, the design adds Lyapunov-based dynamic power control for low-power computing. The resulting embedded UAV platform integrates control, communication, and computing so that the three components operate together during stable reconnaissance missions, and its performance is evaluated in each of these aspects.},
  abbr         = {IEEE TAES},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{LLM_RL_Satellite_Scheduling,
  author       = {Ahn, Hyojun and Kim, Gyu Seon and Cho, In-Sop and Jung, Soyi and Kim, Joongheon},
  title        = {Hybrid Large Language Models and Reinforcement Learning for Energy-Efficient Multisatellite Scheduling: Boosting the Performance From Scratch},
  journal      = {IEEE Internet of Things Journal},
  year         = {2026},
  month        = {February},
  volume       = {13},
  number       = {3},
  pages        = {5379--5392},
  additional_info = {, vol. 13, no. 3, pp. 5379-5392},
  doi          = {10.1109/JIOT.2025.3645077},
  url          = {https://ieeexplore.ieee.org/document/11301687/},
  abstract     = {LEO constellations offer broad, low-delay connectivity, yet their rapidly changing satellite positions make transmission scheduling difficult. BoostRL combines a large language model with reinforcement learning so that an LLM-generated initial policy supplies informed guidance from the start, overcoming inefficient learning from scratch before the RL agent has acquired useful experience and helping it adapt rapidly to changing network conditions. A hybrid policy gradually transfers decision authority from the language-model recommendations to the autonomous learned policy as training progresses. Tailored Q-value initialization and a modified loss function further align the early optimization process with the LLM's guidance. Simulations driven by two-line-element orbital data show faster convergence and greater scheduling efficiency, supporting BoostRL as an adaptive and scalable method for satellite communication networks at scale.},
  abbr         = {IEEE IoT-J},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{QMARL_SAGIN_Access,
  author       = {Kim, Gyu Seon and Cho, Yeryeong and Chung, Jaehyun and Park, Soohyun and Jung, Soyi and Han, Zhu and Kim, Joongheon},
  title        = {Quantum Multi-Agent Reinforcement Learning for Cooperative Mobile Access in Space-Air-Ground Integrated Networks},
