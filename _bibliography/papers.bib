  year         = {2026},
  month        = {January},
  volume       = {25},
  number       = {1},
  pages        = {1200--1218},
  additional_info = {, vol. 25, no. 1, pp. 1200-1218},
  doi          = {10.1109/TMC.2025.3599683},
  url          = {https://ieeexplore.ieee.org/document/11127131/},
  abstract     = {A SAGIN built only with CubeSats can lose sustainable access in areas such as the polar regions and is also constrained by satellite energy. High-altitude long-endurance UAVs can complement both the coverage and energy shortcomings of the constellation. Adding the two platform types, however, causes each ground station's scheduling-action space to grow with the combined fleet and exposes conventional learning to the curse of dimensionality. The paper proposes a quantum multi-agent reinforcement-learning scheduler that coordinates ground-station access to CubeSats and HALE-UAVs to improve both global availability and energy efficiency. Its quantum formulation reduces the scheduling dimension logarithmically as the number of aerial and space platforms increases. The method also accounts for location-dependent differences in ground-station traffic so that access can be differentiated, and data-intensive experiments in realistic CubeSat and HALE-UAV settings validate its superiority.},
  abbr         = {IEEE TMC},
  category     = {international_journal},
  bibtex_show  = {true},
  selected     = {false}
}

@article{SlimFRL_Caching,
  author       = {Baek, Hankyul and Kim, Gyu Seon and Park, Soohyun and Molisch, Andreas F. and Kim, Joongheon},
