@inproceedings{DC25_RL_Military_UAV,
  author       = {Kim, Gyu Seon and Lee, Sungjoon and Woo, Taejin and Park, Soohyun and Kim, Joongheon},
  title        = {강화학습 기반 군용 무인기 제어 (Reinforcement Learning-based Military {UAV} Control)},
  booktitle    = {Proc. 2025년 한국통신학회 동계종합학술발표회 (Korean Institute of Communications and Information Sciences Winter Conference 2025)},
  year         = {2025},
  month        = {February},
  pages        = {291--292},
  location     = {Yongpyeong, Republic of Korea},
  additional_info = {, pp. 291-292},
  note         = {탄소중립 미래자율통신 연구센터(ITRC) 특별세션},
  url          = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12132782},
  html         = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12132782},
  abstract     = {최근 전장에서 무인 항공기(Unmanned Aerial Vehicle, UAV)는 정찰, 감시, 및 목표 탐지와 같은 임무를 수행하는 데 있어 필수적인 전술적 도구로 자리 잡고 있다. 특히 적진 상공에서 지속적인 정찰 비행을 통해 실시간으로 정보를 수집하는 UAV의 능력은 전술적 우위를 제공하는 핵심 요소로 부각되고 있다. 최근 우크라이나-러시아 전쟁은 전장에서 군용 UAV의 전략적 가치와 중요성을 입증하였다. 이러한 전장에서 UAV가 지속적으로 적진을 감시하고 실시간 정보를 수집하는 능력은 작전 성공의 핵심 요소로 부상하고 있다. 기존에 UAV의 제어기로 많이 사용되었던 기존의 비례-적분-미분(Proportional-Integral-Derivative, PID) 제어기는 동적이고 불확실한 비행 환경에 적응하는 데 한계가 존재한다. 또한 PID와 같은 closed-loop 제어 방법은 역학 시스템이 변화하면 변화하는 시스템에 맞게 제어기를 다시 설계해줘야 하는 문제점이 있다. 이러한 문제점은 UAV의 제어시스템 설계에 있어 보다 유연하고 강건한 제어기의 필요성을 강조한다. 신속한 의사결정이 요구되는 고도로 복잡한 비행 환경에서 강화학습 (Reinforcement Learning, RL) 유망한 해결책 중 하나이다. 따라서 본 논문은 강화학습을 기반으로 UAV가 적진을 원형 궤도로 돌며 안정적이고 효율적으로 정찰 임무를 수행할 수 있도록 제어하는 알고리즘을 제안한다. 훈련된 군용 UAV가 회전경로로 적의 군사시설로 이동하고 특정 타겟 주변을 공전하며 정찰 임무성공률을 극대화할 수 있는 보상함수 설계를 통해 본 논문은 안정적인 정찰 시스템 구축을 목표로 한다. 본 연구는 UAV 정찰 시나리오에서 강화학습 기반 제어 기법의 실용성을 입증하며, 미래의 자율 비행 기술 개발에 중요한 기여를 할 것으로 기대된다.},
  abbr         = {KICS},
  category     = {domestic_conference},
  bibtex_show  = {true},
  selected     = {false}
}

@inproceedings{DC25_RL_Urban_Routing,
  author       = {Na, Yun Seong and Kim, Gyu Seon and Kim, Joongheon},
  title        = {도심 도로 최적 경로 탐색을 위한 강화학습 기법과 최적 알고리즘 제안 (Optimal Algorithm Proposal for Urban Road Pathfinding Using Reinforcement Learning)},
  booktitle    = {Proc. 2025년 한국통신학회 동계종합학술발표회 (Korean Institute of Communications and Information Sciences Winter Conference 2025)},
  year         = {2025},
  month        = {February},
  pages        = {520--521},
  location     = {Yongpyeong, Republic of Korea},
  additional_info = {, pp. 520-521},
  note         = {통신네트워크소사이어티 특별세션},
  url          = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12132100},
  html         = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12132100},
  abstract     = {최근 도심 도로 환경은 복잡한 교차로, 신호 체계, 일방통행 등으로 인해 최적 경로 탐색이 매우 어려운 문제로 부각되고 있다. 특히 자동차 보유 대수의 증가와 함께 도로 환경의 복잡성도 증가하여 물류 최적화, 자율주행, 스마트 시티 등 다양한 응용 분야에서 최적 경로 탐색이 중요한 과제가 되고 있다. 기존의 Dijkstra나 A* 알고리즘은 환경의 변화나 크기에 적응하기 어려운 반면, 강화학습(Reinforcement Learning, RL)은 환경의 사전 모델 없이도 유연하고 적응력 있는 접근법을 제공한다. 강화학습은 심층 신경망, 복합 보상 함수 등의 기술을 통해 내비게이션 성능과 효율성을 크게 향상시킬 수 있다. 본 논문은 강화학습을 활용하여 도시 도로에서 최적 경로를 탐색하는 방법을 제안하며, 그리드 기반 환경에서 여러 알고리즘의 성능을 비교 분석한다. 특히, 강남역과 역삼역 간의 직선도로와 직사각형 블록을 모델링하여 에이전트의 경로 학습과 평가를 진행하였다. 이를 통해 직선도로가 많은 환경에서 제안된 알고리즘의 활용성을 보이고, 강화학습을 통해 복잡한 환경에서도 효과적으로 경로를 탐색할 수 있음을 확인한다.},
  abbr         = {KICS},
  category     = {domestic_conference},
  bibtex_show  = {true},
  selected     = {false}
}

@inproceedings{DC24_RL_Carbon_Neutral_Vehicle,
  author       = {Kim, Gyu Seon and Park, Soohyun and Kim, Joongheon},
  title        = {탄소중립을 위한 강화학습 기반 자율주행 자동차 제어 (Reinforcement Learning-based Self-Driving Vehicle Control for Carbon Neutrality)},
  booktitle    = {Proc. 2024년 한국통신학회 추계종합학술발표회 (Korean Institute of Communications and Information Sciences Fall Conference 2024)},
  year         = {2024},
  month        = {November},
  pages        = {207--208},
  location     = {Gyeongju, Republic of Korea},
  additional_info = {, pp. 207-208},
  note         = {탄소중립 미래자율통신 연구센터(ITRC) 특별세션},
  url          = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12034603},
  html         = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE12034603},
  abstract     = {최근 탄소 배출로 인한 대기오염에 많은 국제기관들이 관심이 가지면서 탄소중립의 중요성이 부각되고 있으며, 자율주행 자동차의 최적 경로 탐색을 통한 매연 감소가 주목받고 있다. 이전의 자율주행 자동차 제어에서는 주로 Proportional-Integral-Derivative (PID) 제어기가 사용되었지만, 고정된 파라미터 기반으로 동작하기 때문에 동적인 환경 변화에 효과적으로 적응하지 못하는 한계가 있다. 특히 PID 제어기는 자율주행 자동차의 복잡하고 비선형적인 역학 시스템을 완전히 반영하기 어렵기 때문에, 주행 중 예기치 않은 장애물이나 도로 상황 변화에 대한 신속하고 효율적인 대응이 어렵다. 이러한 문제점을 해결하기 위해 본 논문에서는 강화학습(Reinforcement Learning, RL)을 활용하여 자율주행 자동차의 최단 경로 탐색 및 제어 성능을 개선하는 새로운 접근 방식을 제안한다. 강화학습 기반의 제어 알고리즘은 자동차의 주행 경로를 학습하고 제어함으로써, 변화하는 도로 환경에서도 최적의 주행 경로를 선택하고 차량의 배출가스를 최소화하여 탄소중립을 실현할 수 있도록 한다. 특히, 강화학습을 통해 주행 경로 상의 다양한 상황을 학습함으로써, 교통 혼잡이나 예기치 못한 장애물 등의 변화에도 신속하고 최적의 대응을 가능하게 한다. 본 논문에서 제안하는 자율주행 자동차 제어 모델은 시뮬레이션 환경에서 다양한 도로 상황과 장애물이 존재하는 실험을 통해 검증되었으며, 그 결과 자동차의 배기가스 배출을 줄이고 최적의 주행 경로를 유지하는 데 있어 우수한 성능을 보였다. 이러한 연구 결과는 자율주행 자동차의 제어 분야에 인공지능(Artificial Intelligence, AI) 기술을 적용하여 탄소중립을 실현하기 위한 새로운 가능성을 제시한다.},
  abbr         = {KICS},
  category     = {domestic_conference},
  bibtex_show  = {true},
  selected     = {false}
}

